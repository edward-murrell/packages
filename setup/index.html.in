  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="#top" class="nav-logo"><span class="nav-logo-mark">EM</span>Edward Murrell</a>
        <p class="footer-tagline">Open-source Linux desktop tools, built natively and signed for every supported release.</p>
      </div>
      <div>
        <p class="footer-col-title">Projects</p>
        <ul class="footer-links">
@PROJECT_LINKS@
        </ul>
      </div>
      <div>
        <p class="footer-col-title">Repository</p>
        <ul class="footer-links">
          <li><a href="setup.sh">setup.sh</a></li>
          <li><a href="key.asc">Signing key</a></li>
          <li><a href="https://github.com/edward-murrell">GitHub profile</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Edward Murrell</p>
      <p>Packages built from each project's GitHub releases.</p>
    </div>
  </div>
</footer>

<script src="site.js"></script>
</body>
</html>
